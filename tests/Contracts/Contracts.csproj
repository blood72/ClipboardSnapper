<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ClipboardSnapper/UiText.cs" Link="UiText.cs" />
    <Compile Include="../../ClipboardSnapper/LanguagePreferences.cs" Link="LanguagePreferences.cs" />
    <EmbeddedResource Include="../../ClipboardSnapper/lang/en.json" LogicalName="ClipboardSnapper.lang.en.json" />
    <Content Include="../../ClipboardSnapper/lang/*.json" Link="lang/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../ClipboardSnapper/ImageModels.cs" Link="ImageModels.cs" />
    <Compile Include="../../ClipboardSnapper/SessionHistory.cs" Link="SessionHistory.cs" />
    <Compile Include="../../ClipboardSnapper/QueueProgress.cs" Link="QueueProgress.cs" />
    <Compile Include="../../ClipboardSnapper/SaveFolderPreferences.cs" Link="SaveFolderPreferences.cs" />
    <Compile Include="../../ClipboardSnapper/FilenameRule.cs" Link="FilenameRule.cs" />
    <Compile Include="../../ClipboardSnapper/PortableConfig.cs" Link="PortableConfig.cs" />
    <Compile Include="../../ClipboardSnapper/NamingPreferences.cs" Link="NamingPreferences.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <Compile Include="../../ClipboardSnapper/ImageSaver.cs" Link="ImageSaver.cs" />
  </ItemGroup>
</Project>
