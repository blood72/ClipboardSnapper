<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ClipboardSnapper/ImageModels.cs" Link="ImageModels.cs" />
    <Compile Include="../../ClipboardSnapper/SessionHistory.cs" Link="SessionHistory.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <Compile Include="../../ClipboardSnapper/ImageSaver.cs" Link="ImageSaver.cs" />
  </ItemGroup>
</Project>
