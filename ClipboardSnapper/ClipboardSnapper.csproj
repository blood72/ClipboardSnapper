<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ClipboardSnapper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(PublishSingleFile)' == 'true'">embedded</DebugType>
    <!-- The two publish modes generate different native manifests and resource indexes. -->
    <IntermediateOutputPath Condition="'$(PublishSingleFile)' == 'true'">$(BaseIntermediateOutputPath)single-file\$(Configuration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(PublishSingleFile)' == 'true'">bin\single-file\$(Configuration)\</OutputPath>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="lang/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup Condition="'$(VCRuntimeDirectory)' != ''">
    <Content Include="$(VCRuntimeDirectory)\*.dll" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep editable packs external at the final publish-item boundary. -->
  <Target Name="KeepLanguagePacksExternal" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="('%(ResolvedFileToPublish.RelativePath)' == 'lang\%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' or '%(ResolvedFileToPublish.RelativePath)' == 'lang/%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)') and '%(ResolvedFileToPublish.Extension)' == '.json'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high" Text="External language publish item: %(ResolvedFileToPublish.RelativePath); ExcludeFromSingleFile=%(ResolvedFileToPublish.ExcludeFromSingleFile)"
        Condition="('%(ResolvedFileToPublish.RelativePath)' == 'lang\%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' or '%(ResolvedFileToPublish.RelativePath)' == 'lang/%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)') and '%(ResolvedFileToPublish.Extension)' == '.json'" />
  </Target>
  <Target Name="VerifyVisualCppRuntime" BeforeTargets="PrepareForPublish" Condition="'$(VCRuntimeDirectory)' != ''">
    <Error Condition="!Exists('$(VCRuntimeDirectory)\vcruntime140.dll') or !Exists('$(VCRuntimeDirectory)\vcruntime140_1.dll') or !Exists('$(VCRuntimeDirectory)\msvcp140.dll')"
           Text="VCRuntimeDirectory must contain the x64 Visual C++ runtime DLLs." />
  </Target>
</Project>
